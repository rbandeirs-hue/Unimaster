# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA faça commit do arquivo .env com valores reais.

# Banco de dados
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=unimaster

# Flask
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=

# Ambiente: development | production
FLASK_ENV=development
FLASK_DEBUG=false

# Servidor
HOST=0.0.0.0
PORT=5000

# CORS — domínios autorizados separados por vírgula
CORS_ORIGINS=http://localhost:5000

# Web Push — instale a dependência: pip install pywebpush (ou pip install -r requirements.txt)
# VAPID: o par público/privado no .env deve ser o mesmo injetado no HTML (vapid_public_key).
# Se mudar o par, apague registos antigos em push_subscriptions ou peça para reativar o sino no navegador.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=admin@seudominio.com   (com ou sem prefixo mailto: — não duplicar mailto:)

# E-mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
