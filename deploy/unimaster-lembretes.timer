[Unit]
Description=Dispara a régua de cobrança do Unimaster (de hora em hora)

[Timer]
# De hora em hora: quem decide se sai mensagem é a régua de cobrança de cada
# academia (dias configurados) e a hora escolhida por ela
# (cobranca_regua_config.hora_envio). Rodar mais vezes não duplica nada — a
# trava em `whatsapp_envios` garante uma etapa por dia.
OnCalendar=*-*-* *:00:00
Persistent=true

[Install]
WantedBy=timers.target
