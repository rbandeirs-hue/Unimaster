[Unit]
Description=Unimaster - ativa os dominios proprios das academias (certificado + nginx)
After=network-online.target nginx.service

[Service]
Type=oneshot
WorkingDirectory=/var/www/Unimaster
ExecStart=/var/www/Unimaster/.venv/bin/python /var/www/Unimaster/scripts/dominios_academias.py --aplicar
